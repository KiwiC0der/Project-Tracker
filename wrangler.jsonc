{
  "name": "project-tracker",
  "compatibility_date": "2026-07-16",
  "assets": {
    "directory": "./dist",
    // SPA: every unmatched path serves index.html so client-side state
    // (and any future routing) survives a direct hit or refresh.
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "pt.anteneh.tech", "custom_domain": true }]
}

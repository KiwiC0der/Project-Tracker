{
  "name": "project-tracker",
  "private": true,
  "version": "2.7.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run archives && tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "hooks": "simple-git-hooks",
    "archives": "node scripts/archive-all.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "backup": "node scripts/backup.mjs",
    "preview:demo": "npm run build:demo && vite preview --outDir dist-demo",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@paper-design/shaders": "^0.0.80",
    "@radix-ui/react-slot": "^1.1.2",
    "@supabase/supabase-js": "^2.48.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "pg": "^8.23.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.5"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  },
  "simple-git-hooks": {
    "pre-commit": "node .githooks/pre-commit.mjs"
  }
}

# Copy this file to .env and fill in the two values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# Without these the app still runs, but in demo mode: accounts and tasks are
# stored in localStorage on the visitor's own device only.
#
# VITE_SUPABASE_ANON_KEY is the publishable client key. It is meant to be
# visible in the browser bundle and is protected by Row Level Security.
# Never put the service_role key here — it bypasses RLS.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
